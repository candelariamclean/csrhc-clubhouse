# Variables de entorno para el backend CSRHC
# En Hostinger, estas se cargan en la sección "Environment Variables" del panel Node.js
# NO subir el archivo .env real a GitHub (solo este ejemplo)

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_DATABASE=tu_base_de_datos
DB_PORT=3306
PORT=3000

# Credenciales del panel admin (elegí las tuyas)
ADMIN_USER=tu_usuario_admin
ADMIN_PASS=tu_contraseña_admin
